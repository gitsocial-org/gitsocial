{
  "_comment": "Shared fixtures for the timeline action of a version: headerAction in core/cache/actions.go and in gs-core.js must give the same action for a header and the header of the version before it. A null prev is a first version.",
  "cases": [
    { "name": "first version of an issue", "prev": null, "cur": { "type": "issue", "state": "open" }, "expect": "" },
    { "name": "issue closed", "prev": { "state": "open" }, "cur": { "state": "closed" }, "expect": "closed" },
    { "name": "issue reopened", "prev": { "state": "closed" }, "cur": { "state": "open" }, "expect": "reopened" },
    { "name": "milestone canceled", "prev": { "state": "open" }, "cur": { "state": "canceled" }, "expect": "canceled" },
    { "name": "sprint started", "prev": { "state": "planned" }, "cur": { "state": "active" }, "expect": "started" },
    { "name": "sprint completed", "prev": { "state": "active" }, "cur": { "state": "completed" }, "expect": "completed" },
    { "name": "sprint back to planned", "prev": { "state": "active" }, "cur": { "state": "planned" }, "expect": "" },
    { "name": "same state, new labels", "prev": { "state": "open" }, "cur": { "state": "open", "labels": "kind/bug" }, "expect": "" },
    { "name": "no state in the edit", "prev": { "state": "open" }, "cur": { "labels": "kind/bug" }, "expect": "" },
    { "name": "pull request merged", "prev": { "state": "open" }, "cur": { "state": "merged" }, "expect": "merged" },
    { "name": "draft marked ready", "prev": { "state": "open", "draft": "true" }, "cur": { "state": "open" }, "expect": "ready" },
    { "name": "converted to draft", "prev": { "state": "open" }, "cur": { "state": "open", "draft": "true" }, "expect": "" },
    { "name": "draft closed", "prev": { "state": "open", "draft": "true" }, "cur": { "state": "closed" }, "expect": "closed" },
    { "name": "review approved", "prev": null, "cur": { "type": "feedback", "review-state": "approved" }, "expect": "approved" },
    { "name": "review comment", "prev": null, "cur": { "type": "feedback", "file": "a.go" }, "expect": "" },
    { "name": "review text edited", "prev": { "review-state": "approved" }, "cur": { "review-state": "approved" }, "expect": "" },
    { "name": "review changed", "prev": { "review-state": "approved" }, "cur": { "review-state": "changes-requested" }, "expect": "changes-requested" },
    { "name": "retraction", "prev": { "state": "open" }, "cur": { "state": "closed", "retracted": "true" }, "expect": "" },
    { "name": "issue assigned", "prev": { "state": "open" }, "cur": { "state": "open", "assignees": "a@example.com" }, "expect": "assigned" },
    { "name": "assignee added to a list", "prev": { "assignees": "a@example.com" }, "cur": { "assignees": "a@example.com, b@example.com" }, "expect": "assigned" },
    { "name": "assignee replaced", "prev": { "assignees": "a@example.com" }, "cur": { "assignees": "b@example.com" }, "expect": "assigned" },
    { "name": "assignee removed", "prev": { "assignees": "a@example.com,b@example.com" }, "cur": { "assignees": "a@example.com" }, "expect": "" },
    { "name": "edit with no assignees", "prev": { "state": "open", "assignees": "a@example.com" }, "cur": { "state": "open" }, "expect": "" },
    { "name": "same assignees in another case and order", "prev": { "assignees": "a@example.com, b@example.com" }, "cur": { "assignees": "B@Example.com,a@example.com" }, "expect": "" },
    { "name": "first version with assignees", "prev": null, "cur": { "type": "issue", "state": "open", "assignees": "a@example.com" }, "expect": "" },
    { "name": "closed and assigned", "prev": { "state": "open" }, "cur": { "state": "closed", "assignees": "a@example.com" }, "expect": "closed" },
    { "name": "retraction that assigns", "prev": { "state": "open" }, "cur": { "state": "open", "assignees": "a@example.com", "retracted": "true" }, "expect": "" },
    { "name": "review requested", "prev": { "state": "open" }, "cur": { "state": "open", "reviewers": "b@example.com" }, "expect": "review-requested" },
    { "name": "reviewer added to a list", "prev": { "reviewers": "b@example.com" }, "cur": { "reviewers": " b@example.com , c@example.com " }, "expect": "review-requested" },
    { "name": "reviewer removed", "prev": { "reviewers": "b@example.com,c@example.com" }, "cur": { "reviewers": "c@example.com" }, "expect": "" },
    { "name": "first version with reviewers", "prev": null, "cur": { "type": "pull-request", "state": "open", "reviewers": "b@example.com" }, "expect": "" },
    { "name": "merged and review requested", "prev": { "state": "open" }, "cur": { "state": "merged", "reviewers": "b@example.com" }, "expect": "merged" },
    { "name": "draft marked ready and review requested", "prev": { "state": "open", "draft": "true" }, "cur": { "state": "open", "reviewers": "b@example.com" }, "expect": "ready" },
    { "name": "assigned and review requested", "prev": { "state": "open" }, "cur": { "state": "open", "assignees": "a@example.com", "reviewers": "b@example.com" }, "expect": "assigned" }
  ]
}
