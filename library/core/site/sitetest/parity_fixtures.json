  "cardSkeleton": {
    "parts": ["card-head", "meta", "card-chips"],
    "head": ["type-glyph", "chip", "subject", "chip"],
    "bodyOnlyParts": ["meta", "body"],
    "cases": [
      { "name": "an issue leaves its state to the tinted glyph", "ext": "pm", "header": { "type": "issue", "state": "open", "labels": "kind/bug" }, "firstLine": "Fix the parser", "expectHead": ["type-glyph", "subject"] },
      { "name": "a draft pull request leads its subject with the draft chip", "ext": "review", "header": { "type": "pull-request", "draft": "true", "head": "feature", "base": "trunk" }, "firstLine": "Rework the walk", "expectHead": ["type-glyph", "chip", "subject"] },
      { "name": "a release trails its subject with the version chip", "ext": "release", "header": { "type": "release", "tag": "v1.0", "version": "1.0.1" }, "firstLine": "Ship the rewrite", "expectHead": ["type-glyph", "subject", "chip"] },
      { "name": "a post heads with its glyph and its subject", "ext": "social", "header": { "type": "post" }, "firstLine": "The tree carries sources only", "expectHead": ["type-glyph", "subject"] },
      { "name": "a comment row takes no head, its first line standing as the card's text", "ext": "social", "header": { "type": "comment", "original": "#commit:aaaaaaaaaaaa" }, "firstLine": "A comment on the issue", "expectHead": [], "expectLead": ["type-glyph"] },
      { "name": "a retracted quote row leads its meta row with the marker", "ext": "social", "header": { "type": "quote", "original": "#commit:aaaaaaaaaaaa", "retracted": "true" }, "firstLine": "Quoting the upstream post", "expectHead": [], "expectLead": ["type-glyph", "chip"] }
    ]
  },
