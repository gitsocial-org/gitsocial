    { "name": "a hash with no message stays prose", "body": "abc1234", "expect": [{ "lines": ["abc1234"] }] },
    { "name": "a full sha reads as a hash", "body": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa Fix the walk", "expect": [{ "notes": [{ "hash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "text": "Fix the walk" }] }] }
