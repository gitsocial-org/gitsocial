#!/usr/bin/env bash
# pre-push - run the quick gate (scripts/check.sh --quick) before any push.
#
# Install once per clone: git config core.hooksPath scripts/hooks
# Skip once: GITSOCIAL_SKIP_GATE=1 git push
set -o pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
zero=0000000000000000000000000000000000000000

# pushed ranges for the commit checks: remote..local per ref, a new branch as local --not --remotes
# refs/gitmsg/* and the gitmsg/* branches carry data commits, whose subjects are not prose, so they are left out
ranges=""
not=""
code=""
while read -r _ local_sha remote_ref remote_sha; do
	if [ -z "$local_sha" ] || [ "$local_sha" = "$zero" ]; then continue; fi
	case "$remote_ref" in refs/gitmsg/* | refs/heads/gitmsg/*) continue ;; esac
	code=1
	if [ "$remote_sha" = "$zero" ]; then
		ranges="$ranges $local_sha"
		not=" --not --remotes"
	else
		ranges="$ranges $remote_sha..$local_sha"
	fi
done
export GITSOCIAL_PUSH_RANGES="${ranges# }$not"

if [ -z "$code" ]; then
	printf 'pre-push: no code refs pushed, skipping scripts/check.sh\n'
	exit 0
fi

if [ -n "${GITSOCIAL_SKIP_GATE:-}" ]; then
	printf 'pre-push: GITSOCIAL_SKIP_GATE set, skipping scripts/check.sh\n'
	exit 0
fi

printf 'pre-push: scripts/check.sh --quick (up to about 90 s warm; GITSOCIAL_SKIP_GATE=1 to skip)\n'
exec "$root/scripts/check.sh" --quick </dev/null
